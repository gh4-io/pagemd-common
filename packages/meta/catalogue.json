    "pagedjsTimeout": "pagedjs_timeout",
    "pagedjs-timeout": "pagedjs_timeout",
    "paged_timeout": "pagedjs_timeout",
    "pagedTimeout": "pagedjs_timeout",
    "paged-timeout": "pagedjs_timeout"
  },
  "gates": {
    "fancy-lists": { "field": "fancy_lists", "value": true }
  }
}
